            <td>
                @Html.DisplayFor(model => item.DateDisponibilite)
            </td>
            <td>
                @Html.DisplayFor(model => item.DateVente)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.PhotoUrl)
            </td>
            <td>
                @Html.DisplayFor(model => item.Reparations)
            </td>
            <td>
                @Html.DisplayFor(model => item.CoutReparations)
            </td>
            <td>
                @Html.DisplayFor(model => item.PrixVente)
            </td>
            <td>
                @Html.DisplayFor(model => item.EstDisponible)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
