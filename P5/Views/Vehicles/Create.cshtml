@model P5.ViewModels.VehicleFormViewModel

@{
    ViewData["Title"] = "Ajouter un véhicule";
}

<h1>Ajouter un véhicule</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <partial name="_CatalogueFields" model="Model" />


            <div class="mb-3">
                <label asp-for="Year" class="form-label"></label>
                <input asp-for="Year" class="form-control" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Vin" class="form-label"></label>
                <input asp-for="Vin" class="form-control" />
                <span asp-validation-for="Vin" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PurchaseDate" class="form-label"></label>
                <input asp-for="PurchaseDate" class="form-control" />
                <span asp-validation-for="PurchaseDate" class="text-danger"></span>
            </div>

            <partial name="_PurchasePriceWithPreview" model="Model" />

            <div class="mb-3">
                <label asp-for="AvailabilityDate" class="form-label"></label>
                <input asp-for="AvailabilityDate" class="form-control" />
                <span asp-validation-for="AvailabilityDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <partial name="_PhotoField" model="Model" />


            <div class="alert alert-info" role="note">
                Le prix de vente est calculé automatiquement : prix d'achat + coût des réparations + marge de @Model.Margin.ToString("C0").
                Les réparations se saisissent depuis la fiche du véhicule, après enregistrement.
            </div>

            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a asp-action="Index" class="btn btn-link">Annuler</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/sale-price-preview.js" asp-append-version="true"></script>
}
