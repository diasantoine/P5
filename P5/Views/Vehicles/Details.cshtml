@model P5.Models.Vehicle

@{
    ViewData["Title"] = Model.Designation;
    var isAdmin = User.IsInRole(P5.Security.AppRoles.Admin);
}

<p><a asp-action="Index" class="ev-back">&#8592; Retour<span class="visually-hidden"> à l'inventaire</span></a></p>

@* Photo à gauche, prix et caractéristiques à droite, comme la maquette. *@
<div class="row g-4">
    <div class="col-md-7">
        @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
        {
            <img src="@Model.PhotoUrl" alt="Photo du véhicule : @Model.Designation" class="img-fluid w-100 mb-3" />
        }
        else
        {
            <div class="ev-photo-placeholder d-flex align-items-center justify-content-center mb-3">Aucune photo pour ce véhicule.</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <h2 class="h5">Description</h2>
            <p>@Model.Description</p>
        }
    </div>

    <div class="col-md-5">
        <h1 class="ev-vehicle-title">@Model.Year @Model.Designation@(string.IsNullOrWhiteSpace(Model.Vin) ? "" : $" — VIN {Model.Vin}")</h1>

        @* Actions réservées au gérant. *@
        @if (isAdmin)
        {
            <p class="mb-1">Vous avez publié cette annonce, vous pouvez la :</p>
            <p class="d-flex gap-3">
                @* Liens vers la page de modification et vers la page de confirmation de suppression. *@
                <a asp-action="Edit" asp-route-id="@Model.Id" class="ev-link-edit">modifier<span class="visually-hidden"> l'annonce</span></a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="ev-link-delete">supprimer<span class="visually-hidden"> l'annonce</span></a>
            </p>
        }

        @if (TempData["SaleError"] is string saleError)
        {
            <div class="alert alert-danger" role="alert">@saleError</div>
        }

        <h2 class="ev-price-title">Prix de vente</h2>
        <p class="ev-price">@Html.DisplayFor(m => m.SalePrice)</p>

        <dl class="ev-specs">
            <dt>@Html.DisplayNameFor(m => m.Year)</dt>
            <dd>@Model.Year</dd>

            <dt>Marque</dt>
            <dd>@Model.Specification?.Brand?.Name</dd>

            <dt>Modèle</dt>
            <dd>@Model.Specification?.CarModel?.Name</dd>

            <dt>Finition</dt>
            <dd>@Model.Specification?.Trim?.Name</dd>
        </dl>

        @if (!Model.IsAvailable)
        {
            <p><span class="badge text-bg-secondary">Vendu le @Model.SaleDate?.ToString("dd/MM/yyyy")</span></p>
        }

        @* Sous le trait pointillé : le prix de revient, la vente et les réparations, informations internes au garage réservées au gérant. *@
        @if (isAdmin)
        {
            <hr class="dashed-separator" />

            <h2 class="h5">Prix de revient</h2>
            <table class="table table-sm">
                <caption>Décomposition du prix de vente.</caption>
                <tbody>
                    <tr>
                        <th scope="row">@Html.DisplayNameFor(m => m.PurchasePrice)</th>
                        <td class="text-end">@Html.DisplayFor(m => m.PurchasePrice)</td>
                    </tr>
                    <tr>
                        <th scope="row">@Html.DisplayNameFor(m => m.RepairsCost)</th>
                        <td class="text-end">@Html.DisplayFor(m => m.RepairsCost)</td>
                    </tr>
                    <tr>
                        <th scope="row">Marge</th>
                        <td class="text-end">@Model.Margin.ToString("C")</td>
                    </tr>
                    <tr class="table-active fw-bold">
                        <th scope="row">@Html.DisplayNameFor(m => m.SalePrice)</th>
                        <td class="text-end">@Html.DisplayFor(m => m.SalePrice)</td>
                    </tr>
                </tbody>
            </table>

            @* « Marquer comme vendu » agit : c'est un bouton dans un formulaire POST, avec la date de vente saisie. *@
            @if (Model.IsAvailable)
            {
                <h2 class="h5">Vente</h2>
                <form asp-action="MarkAsSold" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2 align-items-center mb-4">
                    <label for="saleDate" class="form-label mb-0">Date de vente</label>
                    <input type="date" id="saleDate" name="saleDate" required
                           min="@Model.PurchaseDate.ToString("yyyy-MM-dd")"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm w-auto" />
                    <button type="submit" class="btn btn-sm btn-primary text-nowrap">Marquer comme vendu</button>
                </form>
            }

            <h2 class="h5">Réparations</h2>
            @if (!Model.Repairs.Any())
            {
                <p class="text-muted">Aucune réparation enregistrée.</p>
            }
            else
            {
                <table class="table table-sm">
                    <caption>Réparations enregistrées pour ce véhicule.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Réparation</th>
                            <th scope="col" class="text-end">Coût</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var repair in Model.Repairs)
                        {
                            <tr>
                                <td>@repair.Description</td>
                                <td class="text-end">@repair.Cost.ToString("C")</td>
                                <td class="text-end">
                                    <form asp-controller="Repairs" asp-action="Delete" asp-route-id="@repair.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer<span class="visually-hidden"> la réparation @repair.Description</span></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <a asp-controller="Repairs" asp-action="Create" asp-route-vehicleId="@Model.Id" class="btn btn-sm btn-outline-primary">
                Ajouter une réparation
            </a>
        }
    </div>
</div>
