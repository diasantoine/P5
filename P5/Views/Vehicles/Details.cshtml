@model P5.Models.Vehicle

@{
    ViewData["Title"] = Model.Designation;
    var isAdmin = User.IsInRole(P5.Security.AppRoles.Admin);
}

<p><a asp-action="Index" class="link-secondary">&#8592; Retour<span class="visually-hidden"> à l'inventaire</span></a></p>

<h1>@Model.Designation</h1>
<p class="text-muted">Millésime @Model.Year@(string.IsNullOrWhiteSpace(Model.Vin) ? "" : $" — VIN {Model.Vin}")</p>

<div class="row">
    <div class="col-md-5">
        @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
        {
            <img src="@Model.PhotoUrl" alt="Photo du véhicule : @Model.Designation" class="img-fluid rounded mb-3" />
        }
        else
        {
            <p class="text-muted">Aucune photo pour ce véhicule.</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <h2 class="h5">Description</h2>
            <p>@Model.Description</p>
        }
    </div>

    <div class="col-md-7">
        @* Actions réservées au gérant. *@
        @if (isAdmin)
        {
            <p class="mb-1">Vous avez publié cette annonce, vous pouvez la :</p>
            <div class="d-flex flex-wrap gap-3 align-items-center mb-4">
                @* Liens vers la page de modification et vers la page de confirmation de suppression. *@
                <a asp-action="Edit" asp-route-id="@Model.Id" class="link-secondary">modifier<span class="visually-hidden"> l'annonce</span></a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="link-danger">supprimer<span class="visually-hidden"> l'annonce</span></a>

                @* « Marquer comme vendu » agit : c'est un bouton dans un formulaire POST. *@
                @if (Model.IsAvailable)
                {
                    <form asp-action="MarkAsSold" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                        <label for="saleDate" class="visually-hidden">Date de vente</label>
                        <input type="date" id="saleDate" name="saleDate"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               min="@Model.PurchaseDate.ToString("yyyy-MM-dd")"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm w-auto" />
                        <button type="submit" class="btn btn-sm btn-warning text-nowrap">Marquer comme vendu</button>
                    </form>
                }
            </div>
        }

        <h2 class="h5">Prix</h2>
        @* Le prix de revient (achat, réparations, marge) est une information interne au garage : seul le gérant la voit, tous les autres ne voient que le prix de vente. *@
        <table class="table">
            <caption>@(isAdmin ? "Décomposition du prix de vente." : "Prix de vente du véhicule.")</caption>
            <tbody>
                @if (isAdmin)
                {
                    <tr>
                        <th scope="row">@Html.DisplayNameFor(m => m.PurchasePrice)</th>
                        <td class="text-end">@Html.DisplayFor(m => m.PurchasePrice)</td>
                    </tr>
                    <tr>
                        <th scope="row">@Html.DisplayNameFor(m => m.RepairsCost)</th>
                        <td class="text-end">@Html.DisplayFor(m => m.RepairsCost)</td>
                    </tr>
                    <tr>
                        <th scope="row">Marge</th>
                        <td class="text-end">@Model.Margin.ToString("C")</td>
                    </tr>
                }
                <tr class="table-active fw-bold">
                    <th scope="row">@Html.DisplayNameFor(m => m.SalePrice)</th>
                    <td class="text-end">@Html.DisplayFor(m => m.SalePrice)</td>
                </tr>
            </tbody>
        </table>

        @* Les quatre caractéristiques du véhicule, affichées empilées. *@
        <h2 class="h5">Caractéristiques</h2>
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Year)</dt>
            <dd class="col-sm-8">@Model.Year</dd>

            <dt class="col-sm-4">Marque</dt>
            <dd class="col-sm-8">@Model.Specification?.Brand?.Name</dd>

            <dt class="col-sm-4">Modèle</dt>
            <dd class="col-sm-8">@Model.Specification?.CarModel?.Name</dd>

            <dt class="col-sm-4">Finition</dt>
            <dd class="col-sm-8">@Model.Specification?.Trim?.Name</dd>
        </dl>

        <h2 class="h5">Disponibilité</h2>
        @if (Model.IsAvailable)
        {
            <p><span class="badge text-bg-success">Disponible</span></p>
        }
        else
        {
            <p><span class="badge text-bg-secondary">Vendu le @Model.SaleDate?.ToString("dd/MM/yyyy")</span></p>
        }

        @* Réparations : information interne au garage, comme le prix de revient, réservée au gérant. *@
        @if (isAdmin)
        {
            <hr class="dashed-separator" />

            <h2 class="h5">Réparations</h2>
            @if (!Model.Repairs.Any())
            {
                <p class="text-muted">Aucune réparation enregistrée.</p>
            }
            else
            {
                <table class="table table-sm">
                    <caption>Réparations enregistrées pour ce véhicule.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Réparation</th>
                            <th scope="col" class="text-end">Coût</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var repair in Model.Repairs)
                        {
                            <tr>
                                <td>@repair.Description</td>
                                <td class="text-end">@repair.Cost.ToString("C")</td>
                                <td class="text-end">
                                    <form asp-controller="Repairs" asp-action="Delete" asp-route-id="@repair.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer<span class="visually-hidden"> la réparation @repair.Description</span></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <a asp-controller="Repairs" asp-action="Create" asp-route-vehicleId="@Model.Id" class="btn btn-sm btn-outline-secondary">
                Ajouter une réparation
            </a>
        }
    </div>
</div>
