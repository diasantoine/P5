@model IEnumerable<P5.Models.Vehicle>

@{
    ViewData["Title"] = "Nos voitures";
    var isAdmin = User.IsInRole(P5.Security.AppRoles.Admin);
}

<div class="text-center mb-5">
    <h1 class="ev-page-title">Nos voitures</h1>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary btn-lg">+ Ajouter une voiture</a>
    }
</div>

@if (!Model.Any())
{
    <p class="text-center">Aucun véhicule dans l'inventaire pour le moment.</p>
}
else
{
    @* Une carte par véhicule, deux par ligne : photo à gauche, prix et caractéristiques à droite. *@
    <ul class="list-unstyled row row-cols-1 row-cols-lg-2 g-5">
        @foreach (var item in Model)
        {
            <li class="col">
                <article class="ev-card">
                    @* La carte entière mène à la fiche ; le nom du véhicule distingue les liens pour un lecteur d'écran. *@
                    <a asp-action="Details" asp-route-id="@item.Id" class="ev-card-link">
                        <div class="ev-card-photo">
                            @if (!string.IsNullOrWhiteSpace(item.PhotoUrl))
                            {
                                <img src="@item.PhotoUrl" alt="Photo du véhicule : @item.Designation" />
                            }
                            else
                            {
                                <div class="ev-photo-placeholder d-flex align-items-center justify-content-center">Aucune photo</div>
                            }
                        </div>
                        <div class="ev-card-body">
                            <h2 class="ev-card-title">Prix de vente</h2>
                            <p class="ev-card-price">@Html.DisplayFor(modelItem => item.SalePrice)</p>
                            <dl class="ev-card-specs">
                                <dt>Année</dt>
                                <dd>@item.Year</dd>
                                <dt>Marque</dt>
                                <dd>@item.Specification?.Brand?.Name</dd>
                                <dt>Modèle</dt>
                                <dd>@item.Specification?.CarModel?.Name</dd>
                                <dt>Finition</dt>
                                <dd>@item.Specification?.Trim?.Name</dd>
                            </dl>
                            @if (!item.IsAvailable)
                            {
                                <span class="badge text-bg-secondary">Vendu le @item.SaleDate?.ToString("dd/MM/yyyy")</span>
                            }
                            <span class="visually-hidden">Voir la fiche de @item.Designation</span>
                        </div>
                    </a>
                    @* Le gérant accède à la modification depuis la liste. *@
                    @if (isAdmin)
                    {
                        <p class="ev-card-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="ev-link-edit">modifier<span class="visually-hidden"> @item.Designation</span></a>
                        </p>
                    }
                </article>
            </li>
        }
    </ul>
}
