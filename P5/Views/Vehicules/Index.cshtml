@model IEnumerable<P5.Models.Vehicule>

@{
    ViewData["Title"] = "Inventaire";
    var estAuthentifie = User.Identity?.IsAuthenticated ?? false;
}

<h1>Inventaire des véhicules</h1>

@if (estAuthentifie)
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Ajouter un véhicule</a>
    </p>
}

@if (!Model.Any())
{
    <p>Aucun véhicule dans l'inventaire pour le moment.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <caption>@Model.Count() véhicule(s) dans l'inventaire.</caption>
            <thead>
                <tr>
                    <th scope="col">Photo</th>
                    <th scope="col">Véhicule</th>
                    <th scope="col">@Html.DisplayNameFor(model => model.Finition)</th>
                    <th scope="col">@Html.DisplayNameFor(model => model.Annee)</th>
                    <th scope="col" class="text-end">@Html.DisplayNameFor(model => model.PrixAchat)</th>
                    <th scope="col" class="text-end">@Html.DisplayNameFor(model => model.CoutReparations)</th>
                    <th scope="col" class="text-end">@Html.DisplayNameFor(model => model.PrixVente)</th>
                    <th scope="col">Disponibilité</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    @* La marque n'est accessible qu'à travers le modèle : Vehicule -> ModeleVoiture -> Marque.
                       D'où le .ThenInclude() côté contrôleur. *@
                    var designation = $"{item.ModeleVoiture?.Marque?.Nom} {item.ModeleVoiture?.Nom}".Trim();

                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.PhotoUrl))
                            {
                                <img src="@item.PhotoUrl" alt="Photo du véhicule : @designation" width="80" class="img-thumbnail" />
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@designation</td>
                        <td>@item.Finition</td>
                        <td>@item.Annee</td>
                        <td class="text-end">@Html.DisplayFor(modelItem => item.PrixAchat)</td>
                        <td class="text-end">@Html.DisplayFor(modelItem => item.CoutReparations)</td>
                        <td class="text-end fw-bold">@Html.DisplayFor(modelItem => item.PrixVente)</td>
                        <td>
                            @if (item.EstDisponible)
                            {
                                <span class="badge text-bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">
                                    Vendu le @item.DateVente?.ToString("dd/MM/yyyy")
                                </span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id">Détails</a>
                            @if (estAuthentifie)
                            {
                                <text> | </text>
                                <a asp-action="Edit" asp-route-id="@item.Id">Modifier</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
