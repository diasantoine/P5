@using Microsoft.AspNetCore.Identity
@using P5.Security
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    @* « Ajouter une voiture » ne s'affiche qu'au gérant. *@
    @if (User.IsInRole(AppRoles.Admin))
    {
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" asp-area="" asp-controller="Vehicles" asp-action="Create">Ajouter une voiture</a>
        </li>
    }
    <li class="nav-item">
        <span class="navbar-text">Bonjour @User.Identity?.Name !</span>
    </li>
    <li class="nav-item">
        @* Déconnexion par un bouton dans un formulaire POST. *@
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Vehicles", new { area = "" })" method="post">
            <button type="submit" class="nav-link btn btn-link">Se déconnecter</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Se connecter</a>
    </li>
    @*
        Inscription fermée : seul le compte du gérant existe. Lien conservé pour une évolution éventuelle.
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">S'inscrire</a>
        </li>
    *@
}
</ul>
