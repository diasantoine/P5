@startuml architecture
title Class diagram — Express Voitures (application layers)

hide circle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 75
skinparam class {
  BackgroundColor White
  BorderColor #34495E
  ArrowColor #34495E
}

' Layout: one layer per row, top to bottom. Every dependency points downward,
' except Configuration, read from the side by VehicleService and
' VehiclesController. Security sits beside Services, one row below
' Presentation, so it is reached the same plain downward way.
' No arrow has to cross another one.

package "Presentation" {

  class VehiclesController <<controller>> {
    +index() : IActionResult
    +details(id : Integer) : IActionResult
    +create(form : VehicleFormViewModel) : IActionResult
    +edit(id : Integer, form : VehicleFormViewModel) : IActionResult
    +markAsSold(id : Integer, saleDate : Date) : IActionResult
    +delete(id : Integer) : IActionResult
  }

  class RepairsController <<controller>> {
    +create(form : RepairFormViewModel) : IActionResult
    +delete(id : Integer) : IActionResult
  }

  class VehicleFormViewModel {
    -id : Integer
    -vin : String [0..1]
    -year : Integer
    -brandName : String
    -modelName : String
    -trimName : String
    -specificationId : Integer
    -purchaseDate : Date
    -purchasePrice : Decimal
    -availabilityDate : Date [0..1]
    -description : String [0..1]
    -photo : IFormFile [0..1]
    -photoUrl : String [0..1]
    -catalogue : CatalogueNames [0..1]
    -margin : Decimal
    -repairsCost : Decimal
    --
    +fromEntity(vehicle : Vehicle) : VehicleFormViewModel
    +toEntity() : Vehicle
    +applyTo(vehicle : Vehicle) : void
  }

  class RepairFormViewModel {
    -vehicleId : Integer
    -description : String
    -cost : Decimal
    --
    +toEntity() : Repair
  }
}

package "Services" {

  interface IPhotoStorageService <<interface>> {
    +validate(file : IFormFile) : String [0..1]
    +save(file : IFormFile) : String
    +delete(photoUrl : String [0..1]) : void
  }

  interface IVehicleService <<interface>> {
    +getInventory() : Vehicle [0..*]
    +getDetail(id : Integer) : Vehicle [0..1]
    +getForEdit(id : Integer) : Vehicle [0..1]
    +add(vehicle : Vehicle) : Integer
    +update(vehicle : Vehicle) : Boolean
    +markAsSold(id : Integer, saleDate : Date) : Boolean
    +delete(id : Integer) : Boolean
    +getOrCreateSpecificationId(brandName : String, modelName : String, trimName : String) : Integer
    +getCatalogueNames() : CatalogueNames
  }

  note bottom of IVehicleService
    {getOrCreateSpecificationId resolves the (brand,
    model, trim) triple in ONE transaction: reuses the
    catalogue entry when it exists, creates it when it
    does not. Comparison ignores case and surrounding
    spaces; the spelling already stored always wins.}
  end note

  interface IRepairService <<interface>> {
    +add(repair : Repair) : Integer
    +delete(id : Integer) : Integer [0..1]
    +vehicleExists(vehicleId : Integer) : Boolean
  }

  class PhotoStorageService
  class VehicleService
  class RepairService
}

package "Data" {

  class ApplicationDbContext <<DbContext>> {
    +brands : Brand [0..*]
    +carModels : CarModel [0..*]
    +trims : Trim [0..*]
    +vehicleSpecifications : VehicleSpecification [0..*]
    +vehicles : Vehicle [0..*]
    +repairs : Repair [0..*]
  }

  class SeedData <<static>> {
    +seedAsync(db : ApplicationDbContext) : void
  }

  class IdentitySeed <<static>> {
    +seedAdminAsync(services : IServiceProvider) : void
  }
}

package "Configuration" {

  class PricingOptions {
    -fixedMargin : Decimal
  }

  note bottom of PricingOptions
    {The margin is no longer a constant in the
    code: it comes from configuration so it can
    be changed without a new deployment.}
  end note
}

package "Security" {

  class AppRoles <<static>> {
    +{static} admin : String = "Admin"
  }

  class FrenchIdentityErrorDescriber {
    +duplicateEmail(email : String) : IdentityError
    +passwordTooShort(length : Integer) : IdentityError
  }

  note bottom of FrenchIdentityErrorDescriber
    {AppRoles: one name for the role, not
    copied into views, so it cannot go stale.}

    {FrenchIdentityErrorDescriber extends Identity's
    IdentityErrorDescriber: only messages a visitor can
    trigger while registering. Translates refusals,
    does not weaken the password policy.}
  end note
}

' ---- Presentation: two columns of two rows, each controller above its own
' ---- view model, instead of four classes side by side ----
VehiclesController -[hidden]down- VehicleFormViewModel
RepairsController -[hidden]down- RepairFormViewModel
VehiclesController -[hidden]right- RepairsController

' ---- Services: IVehicleService/VehicleService and IPhotoStorageService/
' ---- PhotoStorageService stacked in one column (interface, then its
' ---- implementation, then the second interface, then its implementation),
' ---- IRepairService/RepairService forming a second column beside it ----
IVehicleService -[hidden]right- IRepairService
IVehicleService <|.down. VehicleService
VehicleService -[hidden]down- IPhotoStorageService
IPhotoStorageService <|.down. PhotoStorageService
IRepairService <|.down. RepairService

' ---- Row 3: data ----
SeedData -[hidden]right- ApplicationDbContext
ApplicationDbContext -[hidden]right- IdentitySeed

' ---- Configuration sits beside Data, read sideways by VehicleService ----
IdentitySeed -[hidden]right- PricingOptions

' ---- Security sits beside Services, one row below Presentation: both
' ---- controllers reach AppRoles the same way they reach the service
' ---- interfaces, a plain downward read, no long diagonal needed ----
IRepairService -[hidden]right- AppRoles
AppRoles -[hidden]down- FrenchIdentityErrorDescriber

' ---- Chain the three layers vertically so the packages stack instead of
' ---- spreading out sideways ----
VehiclesController -[hidden]down- IVehicleService
IVehicleService -[hidden]down- ApplicationDbContext

' ---- Dependencies, all pointing downward ----
VehiclesController .down.> VehicleFormViewModel
RepairsController .down.> RepairFormViewModel
VehiclesController .down.> IVehicleService
RepairsController .down.> IVehicleService
RepairsController .down.> IRepairService
VehiclesController .down.> IPhotoStorageService
VehiclesController .down.> AppRoles : reads
RepairsController .down.> AppRoles : reads
VehicleService .down.> ApplicationDbContext
RepairService .down.> ApplicationDbContext
SeedData .right.> ApplicationDbContext
VehicleService .right.> PricingOptions : reads
VehiclesController .right.> PricingOptions : reads

note top of VehiclesController
  {[Authorize(Roles = AppRoles.Admin)] on the class;
  [AllowAnonymous] on index and details only.
  Registration is open, so being signed in is no
  longer enough to write: only the role decides.}
end note

note bottom of VehicleFormViewModel
  {saleDate is deliberately absent: a vehicle
  is taken off sale only through markAsSold,
  never through an edit form.}

  {specificationId, photoUrl, catalogue, margin and
  repairsCost are [BindNever]: the controller fills
  them for display (suggestions, sale-price preview,
  current photo) but toEntity and applyTo never read
  them back. Nothing computed or resolved server-side
  can be posted.}
end note

note bottom of ApplicationDbContext
  {The controllers never see this class.
  Every query goes through a service.}
end note

note bottom of SeedData
  {Runs at startup, after the pending migrations
  are applied. Inserts the initial inventory only
  when the database is empty: existing data is
  never overwritten.}
end note

note bottom of IdentitySeed
  {Runs at startup, and cannot be a migration: a password
  must be hashed at runtime. Creates the Admin role, the
  manager account, and the link between them — each of the
  three checked separately, so a database created before
  roles existed still gets the missing link.}
end note

note top of RepairsController
  {[Authorize(Roles = AppRoles.Admin)] on the class:
  no action is public, unlike VehiclesController.}
end note

legend bottom right
  |= Notation |= Meaning |
  | <<interface>> | contract; the controller depends on it, not on the implementation |
  | dashed arrow | dependency: the source uses the target (injected through the DI container) |
  | dashed arrow, hollow head | realization: the class implements the interface |
  | 0..* | zero to many |
  All services are registered scoped, matching the DbContext lifetime.
endlegend

@enduml
